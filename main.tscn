[sub_resource type="GDScript" id="GDScript_0xm2m"]
script/source = "extends CharacterBody2D


const JUMP_VELOCITY = -400.0

const ENGINE_ACCEL = 60000.0   # px/s² at 100% throttle
const DRAG = 0.0124            # air drag, sets top speed
const ROLL_RESIST = 120.0      # px/s² constant friction, so the car coasts to a stop
const THROTTLE_RATE = 0.3      # how fast the throttle moves per second
const THROTTLE_CURVE = 6.0     # higher = more gentle at low throttle, punchier at high

var throttle := 0.0            # 0.0 to 1.0
var power := 0.0               # throttle after the curve, 0.0 to 1.0
var lane_changing := false     # set by level.gd during a lane change
var cutscene := false          # true = ignore player input (used by cutscene.gd)
var cutscene_throttle := 0.0   # throttle held while cutscene is true
@onready var wheels: Array[Sprite2D] = [$FrontWheel, $RearWheel]


func _physics_process(delta: float) -> void:
	# Gravity (paused during a lane change)
	if lane_changing:
		velocity.y = 0.0
	elif not is_on_floor():
		velocity += get_gravity() * delta

	# Handle jump.
	if Input.is_action_just_pressed(\"jump\") and is_on_floor() and not lane_changing and not cutscene:
		velocity.y = JUMP_VELOCITY

	# Throttle is a lever: hold up/down to raise or lower it, it stays where you leave it.
	if cutscene:
		throttle = cutscene_throttle
	else:
		throttle += Input.get_axis(\"throttle_down\", \"throttle_up\") * THROTTLE_RATE * delta
	throttle = clampf(throttle, 0.0, 1.0)
	power = (exp(THROTTLE_CURVE * throttle) - 1.0) / (exp(THROTTLE_CURVE) - 1.0)

	# The car only drives forward (right). Throttle sets the engine power.
	var accel := power * ENGINE_ACCEL
	accel -= DRAG * velocity.x * absf(velocity.x)   # drag grows with speed squared
	velocity.x += accel * delta
	velocity.x = move_toward(velocity.x, 0.0, ROLL_RESIST * delta)

	move_and_slide()

	# Roll the wheels: angle per second = speed / radius
	for w in wheels:
		var radius := w.texture.get_height() * absf(w.global_scale.y) / 2.0
		w.rotation += velocity.x * delta / radius
"

